# 이 파일을 복사해 파일명을 .env로 바꾼 뒤, 본인의 키를 넣으세요.
# .env는 .gitignore에 등록되어 있어 깃허브에 올라가지 않습니다.
# OpenAI API 키 발급: https://platform.openai.com

OPENAI_API_KEY="sk-여기에-본인-키를-넣으세요"

# MySQL 접속 정보 (서울 상권 데이터 적재 및 조회용)
MYSQL_USER="root"
MYSQL_PASSWORD="여기에-본인-비밀번호를-넣으세요"
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DB="langgraph_db"
